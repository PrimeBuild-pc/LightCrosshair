<Application x:Class="LightCrosshair.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LightCrosshair.UI.Converters"
             xmlns:vm="clr-namespace:LightCrosshair.UI.ViewModels"
             xmlns:views="clr-namespace:LightCrosshair.UI.Views">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme/Tokens.xaml"/>
        <ResourceDictionary Source="Theme/Controls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <conv:BoolToVisConverter x:Key="Vis"/>
      <conv:BoolToVisConverter x:Key="VisInv" Invert="True"/>
      <conv:NullToVisConverter x:Key="NullVis"/>
      <conv:NullToVisConverter x:Key="NullVisInv" Invert="True"/>
      <conv:Base64ImageConverter x:Key="Png"/>
      <conv:HexBrushConverter x:Key="HexBrush"/>
      <conv:StatusBrushConverter x:Key="StatusBrush"/>
      <conv:EqualsParameterConverter x:Key="Eq"/>
      <conv:KeyToTextConverter x:Key="KeyText"/>
      <conv:KeyTextSingleConverter x:Key="KeyTextSingle"/>
      <DataTemplate DataType="{x:Type vm:StudioViewModel}">
        <views:StudioPage/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
        <views:LibraryPage/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:GamesViewModel}">
        <views:GamesPage/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:HotkeysViewModel}">
        <views:HotkeysPage/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <views:SettingsPage/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:FpsOverlayViewModel}">
        <views:FpsOverlayPage/>
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>

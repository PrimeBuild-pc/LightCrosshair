<Window x:Class="LightCrosshair.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:LightCrosshair.UI.Localization"
        xmlns:controls="clr-namespace:LightCrosshair.UI.Controls"
        Title="{loc:Tr AppName}"
        Icon="assets/icon.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFont}"
        FontSize="13"
        MinWidth="1000"
        MinHeight="640"
        Width="1180"
        Height="740"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.InputBindings>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCurrentCommand}"/>
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCurrentCommand}"/>
    <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCurrentCommand}"/>
  </Window.InputBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Background="{DynamicResource BgBrush}">
      <TextBlock Text="{loc:Tr AppName}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="13"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource CaptionButton}" Content="{x:Static loc:Icons.Minimize}" Click="OnMinimize" AutomationProperties.Name="{loc:Tr Window_Minimize}"/>
        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Click="OnMaximize" AutomationProperties.Name="{loc:Tr Window_Maximize}">
          <TextBlock x:Name="MaxGlyph" Text="{x:Static loc:Icons.Maximize}" FontFamily="{DynamicResource IconFont}"/>
        </Button>
        <Button Style="{StaticResource CaptionButton}" Content="{x:Static loc:Icons.Close}" Click="OnCloseClick" AutomationProperties.Name="{loc:Tr Window_Close}"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="12">
            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CrosshairVisible}" Content="{loc:Tr Nav_Visibility}" AutomationProperties.Name="{loc:Tr Nav_Visibility}" Margin="0,0,0,12"/>
            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.FpsEnabled}" Content="{loc:Tr Nav_FpsVisible}" AutomationProperties.Name="{loc:Tr Nav_FpsVisible}" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding LinkState, Converter={StaticResource StatusBrush}}"/>
              <TextBlock Margin="8,0,0,0" Style="{StaticResource LabelText}" VerticalAlignment="Center">
                <TextBlock.Text>
                  <MultiBinding Converter="{StaticResource KeyText}">
                    <Binding Source="{x:Static loc:Loc.Instance}" Path="Version"/>
                    <Binding Path="StatusKey"/>
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </StackPanel>
          </StackPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,16,12,8">
            <controls:CrispIcon VerticalAlignment="Center" AutomationProperties.Name="{loc:Tr AppName}"/>
            <TextBlock Text="{loc:Tr AppName}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14"/>
          </StackPanel>
          <StackPanel Margin="8,8,8,0">
            <Button Command="{Binding NavigateCommand}" CommandParameter="studio" AutomationProperties.Name="{loc:Tr Nav_Studio}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                  <Setter Property="HorizontalContentAlignment" Value="Left"/>
                  <Setter Property="Padding" Value="10,8"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Page}" Value="studio">
                      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                      <Setter Property="BorderThickness" Value="2,0,0,0"/>
                      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{DynamicResource IconFont}" Text="{x:Static loc:Icons.Studio}" Margin="0,0,8,0"/>
                <TextBlock Text="{loc:Tr Nav_Studio}" TextWrapping="Wrap"/>
              </StackPanel>
            </Button>
            <Button Command="{Binding NavigateCommand}" CommandParameter="library" AutomationProperties.Name="{loc:Tr Nav_Library}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                  <Setter Property="HorizontalContentAlignment" Value="Left"/>
                  <Setter Property="Padding" Value="10,8"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Page}" Value="library">
                      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                      <Setter Property="BorderThickness" Value="2,0,0,0"/>
                      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{DynamicResource IconFont}" Text="{x:Static loc:Icons.Library}" Margin="0,0,8,0"/>
                <TextBlock Text="{loc:Tr Nav_Library}" TextWrapping="Wrap"/>
              </StackPanel>
            </Button>
            <Button Command="{Binding NavigateCommand}" CommandParameter="games" AutomationProperties.Name="{loc:Tr Nav_Games}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                  <Setter Property="HorizontalContentAlignment" Value="Left"/>
                  <Setter Property="Padding" Value="10,8"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Page}" Value="games">
                      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                      <Setter Property="BorderThickness" Value="2,0,0,0"/>
                      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{DynamicResource IconFont}" Text="{x:Static loc:Icons.Games}" Margin="0,0,8,0"/>
                <TextBlock Text="{loc:Tr Nav_Games}" TextWrapping="Wrap"/>
              </StackPanel>
            </Button>
            <Button Command="{Binding NavigateCommand}" CommandParameter="hotkeys" AutomationProperties.Name="{loc:Tr Nav_Hotkeys}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                  <Setter Property="HorizontalContentAlignment" Value="Left"/>
                  <Setter Property="Padding" Value="10,8"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Page}" Value="hotkeys">
                      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                      <Setter Property="BorderThickness" Value="2,0,0,0"/>
                      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{DynamicResource IconFont}" Text="{x:Static loc:Icons.Hotkeys}" Margin="0,0,8,0"/>
                <TextBlock Text="{loc:Tr Nav_Hotkeys}" TextWrapping="Wrap"/>
              </StackPanel>
            </Button>
            <Button Command="{Binding NavigateCommand}" CommandParameter="fps" AutomationProperties.Name="{loc:Tr Nav_FpsOverlay}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                  <Setter Property="HorizontalContentAlignment" Value="Left"/>
                  <Setter Property="Padding" Value="10,8"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Page}" Value="fps">
                      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                      <Setter Property="BorderThickness" Value="2,0,0,0"/>
                      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{DynamicResource IconFont}" Text="{x:Static loc:Icons.FpsOverlay}" Margin="0,0,8,0"/>
                <TextBlock Text="{loc:Tr Nav_FpsOverlay}" TextWrapping="Wrap"/>
              </StackPanel>
            </Button>
            <Button Command="{Binding NavigateCommand}" CommandParameter="settings" AutomationProperties.Name="{loc:Tr Nav_Settings}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                  <Setter Property="HorizontalContentAlignment" Value="Left"/>
                  <Setter Property="Padding" Value="10,8"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Page}" Value="settings">
                      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                      <Setter Property="BorderThickness" Value="2,0,0,0"/>
                      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{DynamicResource IconFont}" Text="{x:Static loc:Icons.Settings}" Margin="0,0,8,0"/>
                <TextBlock Text="{loc:Tr Nav_Settings}" TextWrapping="Wrap"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1" Margin="24">
        <ContentControl Content="{Binding CurrentPage}" IsEnabled="{Binding IsPageEnabled}"/>
        <Border Background="{DynamicResource BgBrush}" Visibility="{Binding ShowBlock, Converter={StaticResource Vis}}" Panel.ZIndex="1">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
          <TextBlock Style="{StaticResource BodyText}" TextAlignment="Center" Margin="0,0,0,16">
            <TextBlock.Text>
              <MultiBinding Converter="{StaticResource KeyText}">
                <Binding Source="{x:Static loc:Loc.Instance}" Path="Version"/>
                <Binding Path="BlockKey"/>
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
          <Button HorizontalAlignment="Center" Style="{StaticResource PrimaryButton}" Content="{loc:Tr Retry}" Command="{Binding RetryCommand}" AutomationProperties.Name="{loc:Tr Retry}"
                  Visibility="{Binding CanRetry, Converter={StaticResource Vis}}"/>
        </StackPanel>
        </Border>
      </Grid>
    </Grid>
    <Grid x:Name="DialogLayer" Grid.Row="1" Panel.ZIndex="2" Visibility="{Binding Ui.Dialogs.IsOpen, Converter={StaticResource Vis}}" Background="{DynamicResource ScrimBrush}"
          PreviewKeyDown="OnDialogKey" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
      <Border Width="420" Padding="24" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Center"
              AutomationProperties.Name="{Binding Ui.Dialogs.Title}">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Ui.Dialogs.Title}" TextWrapping="Wrap"/>
          <TextBlock Style="{StaticResource BodyText}" Text="{Binding Ui.Dialogs.Message}" TextWrapping="Wrap" Margin="0,0,0,16"/>
          <ItemsControl x:Name="DialogButtons" ItemsSource="{Binding Ui.Dialogs.Buttons}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Text}" Command="{Binding Command}" Margin="8,0,0,0" MinWidth="32" AutomationProperties.Name="{Binding Text}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                          <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                          <Setter Property="BorderThickness" Value="0"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDanger}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                          <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>
    <Popup x:Name="UsePopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
           IsOpen="{Binding Library.UseOpen, Mode=TwoWay}" Opened="OnUseOpened">
      <Border Padding="12" Width="320" Focusable="True" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" PreviewKeyDown="OnUseKey">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Library_UseTitle}"/>
          <TextBlock Style="{StaticResource BodyText}" Text="{loc:Tr Library_AlreadySaved}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding Library.ShowUseExisting, Converter={StaticResource Vis}}"/>
          <TextBox x:Name="UseNameBox" Text="{Binding Library.UseName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" Visibility="{Binding Library.ShowUseName, Converter={StaticResource Vis}}" AutomationProperties.Name="{loc:Tr Library_UseTitle}"/>
          <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Tr Library_UseExisting}" Command="{Binding Library.ConfirmUseCommand}" Margin="0,0,8,8" Visibility="{Binding Library.ShowUseExisting, Converter={StaticResource Vis}}" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="{loc:Tr Library_UseExisting}"/>
            <Button Content="{loc:Tr Library_SaveCopy}" Command="{Binding Library.SaveAnotherCopyCommand}" Margin="0,0,8,8" Visibility="{Binding Library.ShowUseExisting, Converter={StaticResource Vis}}" AutomationProperties.Name="{loc:Tr Library_SaveCopy}"/>
            <Button Content="{loc:Tr Library_Use}" Command="{Binding Library.ConfirmUseCommand}" Margin="0,0,8,8" Visibility="{Binding Library.ShowUseName, Converter={StaticResource Vis}}" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="{loc:Tr Library_Use}"/>
            <Button Content="{loc:Tr Cancel}" Command="{Binding Library.CancelUseCommand}" Margin="0,0,0,8" AutomationProperties.Name="{loc:Tr Cancel}"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </Popup>
    <ItemsControl Grid.Row="1" Panel.ZIndex="3" ItemsSource="{Binding Ui.Toasts}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,16,16" IsHitTestVisible="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,6,0,0" MaxWidth="360">
            <TextBlock Style="{StaticResource BodyText}" Text="{Binding Message}"/>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</Window>

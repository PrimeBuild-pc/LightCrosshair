<UserControl x:Class="LightCrosshair.UI.Views.GamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LightCrosshair.UI.Localization"
             xmlns:controls="clr-namespace:LightCrosshair.UI.Controls"
             xmlns:contracts="clr-namespace:LightCrosshair.Contracts;assembly=LightCrosshair.Contracts">
  <Grid>
    <DockPanel>
    <Border DockPanel.Dock="Top" Margin="0,0,0,16" Padding="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
            Visibility="{Binding Suggestion, Converter={StaticResource NullVis}}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource PrimaryButton}" Content="{loc:Tr Games_Create}" Command="{Binding AcceptSuggestionCommand}" Margin="0,0,8,0" AutomationProperties.Name="{loc:Tr Games_Create}"/>
          <Button Content="{loc:Tr Games_NotNow}" Command="{Binding NotNowCommand}" Margin="0,0,8,0" AutomationProperties.Name="{loc:Tr Games_NotNow}"/>
          <Button Content="{loc:Tr Games_Never}" Command="{Binding NeverCommand}" AutomationProperties.Name="{loc:Tr Games_Never}"/>
        </StackPanel>
        <TextBlock Style="{StaticResource BodyText}" VerticalAlignment="Center" Text="{Binding SuggestionText}" TextWrapping="Wrap"/>
      </DockPanel>
    </Border>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <DockPanel Margin="0,0,16,0">
        <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Content="{loc:Tr Games_Add}" Command="{Binding StartAddCommand}" Margin="0,0,0,12" AutomationProperties.Name="{loc:Tr Games_Add}"/>
        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Games_Empty}">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Profiles.Count}" Value="0">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource NamedItem}" AutomationProperties.Name="{loc:Tr Nav_Games}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding Name}"/>
                  <TextBlock Style="{StaticResource LabelText}" Text="{Binding ProcessName}"/>
                </StackPanel>
                <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=OneWay}"
                          PreviewMouseLeftButtonDown="OnToggleEnabled" PreviewKeyDown="OnToggleEnabledKey"
                          AutomationProperties.Name="{loc:Tr Games_Enabled}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding Selected, Converter={StaticResource NullVis}}">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
          <TextBlock Style="{StaticResource WarningText}" Text="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource NullVis}}"/>
          <TextBlock Style="{StaticResource LabelText}" Text="{loc:Tr Games_ProfileName}"/>
          <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,12" AutomationProperties.Name="{loc:Tr Games_ProfileName}"/>
          <TextBlock Style="{StaticResource LabelText}" Text="{loc:Tr Games_Process}"/>
          <TextBlock Style="{StaticResource BodyText}" Text="{Binding ProcessName}" Margin="0,4,0,12"/>
          <TextBlock Style="{StaticResource LabelText}" Text="{loc:Tr Games_Crosshair}"/>
          <ComboBox ItemsSource="{Binding Crosshairs}" SelectedValuePath="Id" SelectedValue="{Binding CrosshairId}" Margin="0,4,0,8" AutomationProperties.Name="{loc:Tr Games_Crosshair}" ItemContainerStyle="{StaticResource NamedComboItem}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Style="{StaticResource LabelText}" Text="{loc:Tr Games_UsePreset}"/>
          <ComboBox x:Name="PresetPick" ItemsSource="{Binding PresetPicks}" Margin="0,4,0,12" SelectionChanged="OnPresetPicked" AutomationProperties.Name="{loc:Tr Games_UsePreset}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Design.Name}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Games_VisibilityOverride}"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4" KeyboardNavigation.DirectionalNavigation="Cycle" AutomationProperties.Name="{loc:Tr Games_VisibilityOverride}">
            <RadioButton Style="{StaticResource Segment}" GroupName="VisibilityPolicy" Content="{loc:Tr Override_Global}" AutomationProperties.Name="{loc:Tr Override_Global}" IsChecked="{Binding VisibilityPolicy, Converter={StaticResource Eq}, ConverterParameter=follow}"/>
            <RadioButton Style="{StaticResource Segment}" GroupName="VisibilityPolicy" Content="{loc:Tr Games_HoldOff}" AutomationProperties.Name="{loc:Tr Games_HoldOff}" IsChecked="{Binding VisibilityPolicy, Converter={StaticResource Eq}, ConverterParameter=off}"/>
            <RadioButton Style="{StaticResource Segment}" GroupName="VisibilityPolicy" Content="{loc:Tr Override_Custom}" AutomationProperties.Name="{loc:Tr Override_Custom}" IsChecked="{Binding VisibilityPolicy, Converter={StaticResource Eq}, ConverterParameter=custom}"/>
          </StackPanel>
          <TextBlock Style="{StaticResource LabelText}" Text="{Binding GlobalVisibilityText}" Margin="0,0,0,8"/>
          <Grid Visibility="{Binding HasOwnVisibility, Converter={StaticResource Vis}}" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <controls:BindingCaptureBox Binding="{Binding Visibility}" Prompt="{loc:Tr Hotkeys_Press}"
                                         CapturedCommand="{Binding CommitVisibilityCommand}" CaptureChangedCommand="{Binding SetCaptureCommand}" CommandParameter="VisibilityBinding"/>
            <ComboBox Grid.Column="1" MinWidth="160" Margin="8,0,0,0" SelectedValue="{Binding VisibilityMode}" SelectedValuePath="Tag" AutomationProperties.Name="{loc:Tr Hotkeys_Mode}">
              <ComboBoxItem Tag="{x:Static contracts:BindingMode.Toggle}" Content="{loc:Tr Hotkeys_Toggle}"/>
              <ComboBoxItem Tag="{x:Static contracts:BindingMode.HoldToHide}" Content="{loc:Tr Hotkeys_HoldHide}"/>
              <ComboBoxItem Tag="{x:Static contracts:BindingMode.HoldToShow}" Content="{loc:Tr Hotkeys_HoldShow}"/>
            </ComboBox>
          </Grid>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Hotkeys_WhileHeld}"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4" KeyboardNavigation.DirectionalNavigation="Cycle" AutomationProperties.Name="{loc:Tr Games_HoldPolicy}">
            <RadioButton Style="{StaticResource Segment}" GroupName="HoldPolicy" Content="{loc:Tr Override_Global}" AutomationProperties.Name="{loc:Tr Override_Global}" IsChecked="{Binding HoldPolicy, Converter={StaticResource Eq}, ConverterParameter=follow}"/>
            <RadioButton Style="{StaticResource Segment}" GroupName="HoldPolicy" Content="{loc:Tr Games_HoldOff}" AutomationProperties.Name="{loc:Tr Games_HoldOff}" IsChecked="{Binding HoldPolicy, Converter={StaticResource Eq}, ConverterParameter=off}"/>
            <RadioButton Style="{StaticResource Segment}" GroupName="HoldPolicy" Content="{loc:Tr Override_Custom}" AutomationProperties.Name="{loc:Tr Override_Custom}" IsChecked="{Binding HoldPolicy, Converter={StaticResource Eq}, ConverterParameter=custom}"/>
          </StackPanel>
          <TextBlock Style="{StaticResource LabelText}" Text="{Binding GlobalHoldText}" Margin="0,0,0,8"/>
          <Grid Visibility="{Binding HasOwnHold, Converter={StaticResource Vis}}" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <controls:BindingCaptureBox Binding="{Binding HoldBinding}" Prompt="{loc:Tr Hotkeys_Press}" AllowWheel="False" CapturedCommand="{Binding CommitHoldCommand}" CaptureChangedCommand="{Binding SetCaptureCommand}" CommandParameter="HoldVisibility"/>
            <ComboBox Grid.Column="1" MinWidth="160" Margin="8,0,0,0" SelectedValue="{Binding HoldMode}" SelectedValuePath="Tag" AutomationProperties.Name="{loc:Tr Hotkeys_Mode}">
              <ComboBoxItem Tag="{x:Static contracts:BindingMode.HoldToHide}" Content="{loc:Tr Hotkeys_HoldHide}"/>
              <ComboBoxItem Tag="{x:Static contracts:BindingMode.HoldToShow}" Content="{loc:Tr Hotkeys_HoldShow}"/>
            </ComboBox>
          </Grid>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Games_FpsOverlay}"/>
          <ComboBox SelectedValue="{Binding FpsMode}" SelectedValuePath="Tag" Margin="0,0,0,12" AutomationProperties.Name="{loc:Tr Games_FpsOverlay}">
            <ComboBoxItem Tag="follow" Content="{loc:Tr Games_FollowGlobal}"/>
            <ComboBoxItem Tag="on" Content="{loc:Tr On}"/>
            <ComboBoxItem Tag="off" Content="{loc:Tr Off}"/>
          </ComboBox>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Games_DisplayColors}"/>
          <TextBlock Style="{StaticResource WarningText}" Text="{Binding DisplayColorsMessage}" TextWrapping="Wrap" Visibility="{Binding DisplayColorsMessage, Converter={StaticResource NullVis}}" Margin="0,0,0,8"/>
          <CheckBox Style="{StaticResource Switch}" Content="{loc:Tr Games_UseColors}" IsChecked="{Binding UseColors}" IsEnabled="{Binding GammaSupported}" AutomationProperties.Name="{loc:Tr Games_UseColors}"/>
          <TextBlock Style="{StaticResource LabelText}" Text="{loc:Tr Games_ReasonGamma}" Visibility="{Binding GammaSupported, Converter={StaticResource VisInv}}" Margin="0,4,0,8"/>
          <StackPanel Visibility="{Binding UseColors, Converter={StaticResource Vis}}">
            <controls:NumberSlider Caption="{loc:Tr Games_Gamma}" Value="{Binding Gamma}" Minimum="50" Maximum="150"/>
            <controls:NumberSlider Caption="{loc:Tr Games_Contrast}" Value="{Binding Contrast}" Minimum="50" Maximum="150"/>
            <controls:NumberSlider Caption="{loc:Tr Games_Brightness}" Value="{Binding Brightness}" Minimum="50" Maximum="150"/>
            <controls:NumberSlider Caption="{loc:Tr Games_Vibrance}" Value="{Binding Vibrance}" Minimum="0" Maximum="100"/>
          </StackPanel>
          <TextBlock Style="{StaticResource LabelText}" Text="{loc:Tr Games_ReasonNvidiaColor}" Visibility="{Binding NvidiaColorSupported, Converter={StaticResource VisInv}}"/>
          <controls:NumberSlider Caption="{loc:Tr Games_NvidiaVibrance}" Value="{Binding NvidiaVibrance}" Minimum="0" Maximum="100" IsEnabled="{Binding NvidiaColorSupported}" Visibility="{Binding UseColors, Converter={StaticResource Vis}}"/>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Games_FpsCap}"/>
          <TextBlock Style="{StaticResource LabelText}" Text="{loc:Tr Games_ReasonNvidiaCap}" Visibility="{Binding CapSupported, Converter={StaticResource VisInv}}"/>
          <CheckBox Style="{StaticResource Switch}" Content="{loc:Tr Games_FpsCap}" IsChecked="{Binding UseCap}" IsEnabled="{Binding CapSupported}" AutomationProperties.Name="{loc:Tr Games_FpsCap}"/>
          <controls:NumberSlider Caption="{loc:Tr Games_CapValue}" Value="{Binding Cap}" Minimum="30" Maximum="480" Visibility="{Binding UseCap, Converter={StaticResource Vis}}"/>
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="{loc:Tr Games_Save}" Command="{Binding SaveCommand}" Margin="0,0,8,0" AutomationProperties.Name="{loc:Tr Games_Save}"/>
            <Button Style="{StaticResource DangerButton}" Content="{loc:Tr Games_Delete}" Command="{Binding DeleteCommand}" AutomationProperties.Name="{loc:Tr Games_Delete}"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    </DockPanel>
    <Border Visibility="{Binding Picking, Converter={StaticResource Vis}}" Background="{DynamicResource ScrimBrush}" Panel.ZIndex="4">
      <Border Width="420" Padding="16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Center">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="{loc:Tr Games_Add}"/>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource BodyText}" Text="{loc:Tr Games_PickProcess}" Margin="0,0,0,8"/>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{loc:Tr Browse}" Command="{Binding BrowseExeCommand}" Margin="0,0,8,0" AutomationProperties.Name="{loc:Tr Browse}"/>
            <Button Content="{loc:Tr Cancel}" Command="{Binding CancelPickCommand}" AutomationProperties.Name="{loc:Tr Cancel}"/>
          </StackPanel>
          <ListBox ItemsSource="{Binding Processes}" AutomationProperties.Name="{loc:Tr Games_Running}">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="AutomationProperties.Name" Value="{Binding ProcessName}"/>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding ProcessName}" Command="{Binding DataContext.AddProcessCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" HorizontalContentAlignment="Left" AutomationProperties.Name="{Binding ProcessName}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>

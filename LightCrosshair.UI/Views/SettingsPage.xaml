<UserControl x:Class="LightCrosshair.UI.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LightCrosshair.UI.Localization"
             xmlns:controls="clr-namespace:LightCrosshair.UI.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
      <TextBlock Style="{StaticResource WarningText}" Text="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource NullVis}}"/>
      <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Settings_Display}"/>
      <TextBlock Style="{StaticResource LabelText}" Text="{loc:Tr Settings_Monitor}"/>
      <ComboBox ItemsSource="{Binding MonitorChoices}" SelectedValuePath="DeviceName" SelectedValue="{Binding MonitorDeviceName}" Margin="0,4,0,8" AutomationProperties.Name="{loc:Tr Settings_Monitor}" ItemContainerStyle="{StaticResource TextComboItem}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Label}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Settings_Position}"/>
      <controls:OffsetDiagram OffsetX="{Binding OffsetX}" OffsetY="{Binding OffsetY}"/>
      <controls:NumberSlider Caption="{loc:Tr Settings_OffsetX}" Value="{Binding OffsetX}" Minimum="-200" Maximum="200" Unit="{loc:Tr Unit_Px}"/>
      <controls:NumberSlider Caption="{loc:Tr Settings_OffsetY}" Value="{Binding OffsetY}" Minimum="-200" Maximum="200" Unit="{loc:Tr Unit_Px}"/>

      <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Settings_Behavior}"/>
      <CheckBox Style="{StaticResource Switch}" Content="{loc:Tr Settings_OnlyGames}" IsChecked="{Binding ShowOnlyInConfiguredGames}" Margin="0,4" AutomationProperties.Name="{loc:Tr Settings_OnlyGames}"/>
      <CheckBox Style="{StaticResource Switch}" Content="{loc:Tr Settings_HideRecording}" IsChecked="{Binding HideDuringScreenRecording}" Margin="0,4" AutomationProperties.Name="{loc:Tr Settings_HideRecording}"/>
      <CheckBox Style="{StaticResource Switch}" Content="{loc:Tr Settings_StartWindows}" IsChecked="{Binding StartWithWindows}" Margin="0,4" AutomationProperties.Name="{loc:Tr Settings_StartWindows}"/>
      <CheckBox Style="{StaticResource Switch}" Content="{loc:Tr Settings_Suggestions}" IsChecked="{Binding SuggestKnownGames}" Margin="0,4,0,12" AutomationProperties.Name="{loc:Tr Settings_Suggestions}"/>

      <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Settings_Language}"/>
      <ComboBox ItemsSource="{Binding Languages}" SelectedValuePath="Id" SelectedValue="{Binding Language}" Margin="0,4,0,12" AutomationProperties.Name="{loc:Tr Settings_Language}" ItemContainerStyle="{StaticResource TextComboItem}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock>
              <TextBlock.Text>
                <MultiBinding Converter="{StaticResource KeyText}">
                  <Binding Source="{x:Static loc:Loc.Instance}" Path="Version"/>
                  <Binding Path="LabelKey"/>
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Settings_Updates}"/>
      <CheckBox Style="{StaticResource Switch}" Content="{loc:Tr Settings_CheckAuto}" IsChecked="{Binding CheckForUpdates}" Margin="0,4" AutomationProperties.Name="{loc:Tr Settings_CheckAuto}"/>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
        <Button Content="{loc:Tr Settings_CheckNow}" Command="{Binding CheckUpdatesCommand}" AutomationProperties.Name="{loc:Tr Settings_CheckNow}"/>
      </StackPanel>
      <TextBlock Style="{StaticResource BodyText}" Text="{Binding UpdateMessage}" Margin="0,4,0,12"/>

      <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Settings_About}"/>
      <TextBlock Style="{StaticResource BodyText}" Text="{Binding VersionText}" Margin="0,0,0,8"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <Button Content="{loc:Tr Settings_Website}" Command="{Binding OpenWebsiteCommand}" Margin="0,0,8,0" AutomationProperties.Name="{loc:Tr Settings_Website}"/>
        <Button Content="{loc:Tr Settings_Source}" Command="{Binding OpenSourceCommand}" AutomationProperties.Name="{loc:Tr Settings_Source}"/>
      </StackPanel>
      <TextBlock Style="{StaticResource LabelText}" Text="{loc:Tr Settings_License}"/>
      <TextBlock Style="{StaticResource BodyText}" Text="{loc:Tr Settings_LicenseText}" Margin="0,4,0,16"/>
      <Button Style="{StaticResource DangerButton}" Content="{loc:Tr Settings_Exit}" Command="{Binding ExitCommand}" HorizontalAlignment="Left" AutomationProperties.Name="{loc:Tr Settings_Exit}"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
